# .env.example

# PayPal client ID used by the browser payment component.
# Use "sb" only for local PayPal sandbox testing.
VITE_PAYPAL_CLIENT_ID=

# Managed OpenRouter server route.
OPENROUTER_API_KEY=

# Legacy server-side alias accepted by api/openrouter.ts.
APEX_INNOVATE_API=

# Optional OpenRouter configuration.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_FALLBACK_MODEL=

# Optional public application URL sent as the OpenRouter HTTP-Referer.
APP_URL=
